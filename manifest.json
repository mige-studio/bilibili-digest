{
  "manifest_version": 3,
  "name": "B站精读",
  "version": "0.1.0",
  "version_name": "0.1.0-candidate.2",
  "minimum_chrome_version": "116",
  "description": "把当前 B 站公开视频转成带时间点与说话人编号的逐字稿，并支持精读、总结、笔记和本机保存。",
  "permissions": [
    "storage",
    "sidePanel",
    "offscreen",
    "alarms",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*"
  ],
  "optional_host_permissions": [
    "https://api.deepseek.com/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "https://openspeech.bytedance.com/*"
  ],
  "action": {
    "default_title": "打开 B站精读（请先打开公开视频）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/panel.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.bilibili.com https://*.bilivideo.com:* https://*.bilivideo.cn:* https://api.deepseek.com https://openspeech.bytedance.com; worker-src 'self'"
  }
}
